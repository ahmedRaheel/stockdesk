# Generate a URL-safe database password (letters/digits/_/-); other characters need URL encoding.
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-value
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
APP_ORIGIN=http://localhost:8080
# Set true when hosted behind HTTPS, and set APP_ORIGIN to that exact origin.
COOKIE_SECURE=false
