# Default deployment reuses the postgres container on chatbot-network.
# Create the stockdesk database first. Replace the password; URL-encode special characters.
DATABASE_URL=postgresql://postgres:REPLACE_DATABASE_PASSWORD@postgres:5432/stockdesk
POSTGRES_NETWORK=chatbot-network
APP_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
ADMIN_EMAIL=owner@example.com
# Set your own 12–128 character application password (separate from PostgreSQL).
ADMIN_PASSWORD=
# Only used with compose.managed.yaml, which starts a separate PostgreSQL container.
POSTGRES_PASSWORD=
