{
  "name": "stockdesk-ui",
  "version": "1.27.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "check:locales": "node scripts/check-locales.cjs",
    "test:request-id": "node --test scripts/request-id.test.cjs"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "plotly.js-dist-min": "3.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/plotly.js": "2.35.1",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "4.7.0",
    "prettier": "^3.5.3",
    "typescript": "5.9.3",
    "vite": "6.3.6"
  }
}
